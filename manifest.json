  "components": [
    {
      "name": "Footer",
      "group": "Chrome",
      "summary": "Use Footer at the bottom of every page."
    },
    {
      "name": "SearchBar",
      "group": "Chrome",
      "summary": "Use SearchBar in the header and in the homepage banner."
    },
    {
      "name": "OrderInfoBar",
      "group": "Commerce",
      "summary": "Use OrderInfoBar directly below add-to-cart on a PDP."
    },
    {
      "name": "OrderSummary",
      "group": "Commerce",
      "summary": "Use OrderSummary on the cart page and in checkout."
    },
    {
      "name": "PdpGallery",
      "group": "Commerce",
      "summary": "Use PdpGallery as the left column of a PDP."
    },
    {
      "name": "ProductInfoTable",
      "group": "Commerce",
      "summary": "Use ProductInfoTable inside the PDP's \"Eigenschaften\" panel."
    },
    {
      "name": "ProductTile",
      "group": "Commerce",
      "summary": "Use ProductTile for every product in a listing, a carousel rail, or a related-products block."
    },
    {
      "name": "BlogCard",
      "group": "Content",
      "summary": "Use BlogCard wherever an article is teased: in the blog archive, in the sidebar, and inside ArticleRow on shop pages."
    },
    {
      "name": "ArticleRow",
      "group": "Content",
      "summary": "Use ArticleRow to tease articles outside the magazine: on the homepage, on a category page, at the end of an article."
    },
    {
      "name": "IconList",
      "group": "Content",
      "summary": "Use IconList for a short set of facts about uWeed or a brand: the \"why uWeed\" band on the homepage or a category page, the facts on a brand page."
    },
    {
      "name": "NewsletterBlock",
      "group": "Content",
      "summary": "Use NewsletterBlock to invite a visitor to the newsletter: on the homepage, at the end of a blog article, or above the footer."
    },
    {
      "name": "Badge",
      "group": "Core",
      "summary": "Use Badge for a small label that classifies, counts or flags something."
    },
    {
      "name": "Button",
      "group": "Core",
      "summary": "Use Button for anything that performs an action or navigates; the variant is chosen by purpose, never by how much attention you want it to have."
    },
    {
      "name": "Card",
      "group": "Core",
      "summary": "Use Card as the shared surface under tiles, panels and grouped blocks — not usually as a component you place by itself."
    },
    {
      "name": "Icon",
      "group": "Core",
      "summary": "Use Icon wherever the interface needs an icon: the order info bar, messages, chevrons in navigation, cart and favourites controls."
    },
    {
      "name": "Logo",
      "group": "Foundations",
      "summary": "The approved uWeed logo kit (August 2026): a horizontal logo, the same logo with the tagline, and the mark, each as a ready-coloured SVG, plus two favicon PNGs."
    },
    {
      "name": "Link",
      "group": "Core",
      "summary": "Use Link for navigation; pick the variant by whether the link has to announce itself, not by where it sits."
    },
    {
      "name": "Price",
      "group": "Core",
      "summary": "Use Price for any price, anywhere."
    },
    {
      "name": "Accordion",
      "group": "Disclosure",
      "summary": "Use Accordion + AccordionItem for FAQ blocks, PDP tabs on mobile, category text and footer columns on mobile."
    },
    {
      "name": "AccordionItem"
    },
    {
      "name": "ContentTabs",
      "group": "Disclosure",
      "summary": "Use ContentTabs for the PDP description / lab report / shipping panels on desktop."
    },
    {
      "name": "FilterPill",
      "group": "Disclosure",
      "summary": "Use FilterPill for every facet trigger — one per facet, always visible."
    },
    {
      "name": "Popover",
      "group": "Disclosure",
      "summary": "Use Popover for any panel that opens from a trigger and floats above the page."
    },
    {
      "name": "PopoverItem"
    },
    {
      "name": "PopoverGroup"
    },
    {
      "name": "PopoverSeparator"
    },
    {
      "name": "PopoverFooter"
    },
    {
      "name": "SortButton",
      "group": "Disclosure",
      "summary": "Use SortButton as the sort control on a listing."
    },
    {
      "name": "Tooltip",
      "group": "Disclosure",
      "summary": "Use Tooltip only for nuance the reader could do without."
    },
    {
      "name": "Message",
      "group": "Feedback",
      "summary": "Use Message for feedback the reader must be able to come back to — form errors, compliance notes, coupon results, shipping notices."
    },
    {
      "name": "Skeleton",
      "group": "Feedback",
      "summary": "Use Skeleton where the incoming shape is known — a reloading product grid, cart drawer rows, filter results."
    },
    {
      "name": "Spinner",
      "group": "Feedback",
      "summary": "Use Spinner when you cannot know the shape of what is coming — a submitting form, an in-flight request."
    },
    {
      "name": "StockStatus",
      "group": "Feedback",
      "summary": "Use StockStatus on a PDP below the variation selector."
    },
    {
      "name": "Toast",
      "group": "Feedback",
      "summary": "Use Toast to confirm an action that succeeded and needs no decision."
    },
    {
      "name": "Checkbox",
      "group": "Forms",
      "summary": "Use Checkbox for independent on/off and for filter facets."
    },
    {
      "name": "CouponForm",
      "group": "Forms",
      "summary": "Use CouponForm on the cart page, in the cart drawer and at checkout."
    },
    {
      "name": "FormField",
      "group": "Forms",
      "summary": "Use FormField around every form control."
    },
    {
      "name": "Input",
      "group": "Forms",
      "summary": "Use Input for any text entry."
    },
    {
      "name": "QuantitySelector",
      "group": "Forms",
      "summary": "Use QuantitySelector wherever a quantity is set or shown."
    },
    {
      "name": "Radio",
      "group": "Forms",
      "summary": "Use RadioGroup + Radio for any single-choice set."
    },
    {
      "name": "RadioGroup"
    },
    {
      "name": "Select",
      "group": "Forms",
      "summary": "Use Select for one-of-many where the list is known."
    },
    {
      "name": "Breadcrumb",
      "group": "Navigation",
      "summary": "Use Breadcrumb above the H1 on category and product pages."
    },
    {
      "name": "Carousel",
      "group": "Navigation",
      "summary": "Use Carousel for a horizontal rail of products or city tiles."
    },
    {
      "name": "Pagination",
      "group": "Navigation",
      "summary": "Use Pagination below a product grid or blog archive."
    },
    {
      "name": "TabNav",
      "group": "Navigation",
      "summary": "Use TabNav for one axis of category filtering above a grid or a rail."
    },
    {
      "name": "AgeGate",
      "group": "Overlays",
      "summary": "Use AgeGate as the first thing a visitor sees."
    },
    {
      "name": "CartDrawer",
      "group": "Overlays",
      "summary": "Use CartDrawer for the slide-in cart."
    },
    {
      "name": "FilterPanel",
      "group": "Overlays",
      "summary": "Use FilterPanel for filtering and sorting a product listing below lg, where the row of filter pills has no room."
    },
    {
      "name": "Modal",
      "group": "Overlays",
      "summary": "Use Modal rarely — a destructive confirmation or a required choice."
    },
    {
      "name": "ColourPairings",
      "group": "Foundations",
      "summary": "Approved text and background pairs, and the ones that fail.",
      "page": true
    },
    {
      "name": "Colours",
      "group": "Foundations",
      "summary": "The palette by family: each family has one job.",
      "page": true
    },
    {
      "name": "ContentTable",
      "group": "Content",
      "summary": "A multi-column table for editorial content: comparisons, reference data, specs and figures inside blog articles and category pages."
    },
    {
      "name": "MotionAndStacking",
      "group": "Foundations",
      "summary": "Three durations and one easing; eleven stacking tokens.",
      "page": true
    },
    {
      "name": "ProductListing",
      "group": "Pages",
      "summary": "A category page (PLP) built from this system's components: the page to copy when you build a listing.",
      "page": true
    },
    {
      "name": "ShopPrototype",
      "group": "Pages",
      "summary": "A clickable mock of the uweed.ch shop, built only from this design system's components.",
      "page": true
    },
    {
      "name": "SpacingAndShape",
      "group": "Foundations",
      "summary": "The spacing scale in use, radius, border widths and elevation.",
      "page": true
    },
    {
      "name": "Typography",
      "group": "Foundations",
      "summary": "Poppins for headings, DM Sans for everything else, fluid between 375 and 1280px.",
      "page": true
    }
  ],
